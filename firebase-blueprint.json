{
  "entities": {
    "Participant": {
      "title": "Participant",
      "description": "Registered student details for the Canva workshop",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "full_name": { "type": "string" },
        "email": { "type": "string" },
        "whatsapp": { "type": "string" },
        "device": { "type": "string" },
        "canva_experience": { "type": "string" },
        "learning_interest": { "type": "string" },
        "status": { "type": "string" },
        "ticket_number": { "type": "string" },
        "registration_date": { "type": "string" },
        "registration_time": { "type": "string" },
        "whatsapp_joined": { "type": "boolean" },
        "attendance_day_1": { "type": "boolean" },
        "attendance_day_2": { "type": "boolean" },
        "attendance_day_3": { "type": "boolean" },
        "masterclass_interest": { "type": "boolean" },
        "email_status": { "type": "string" },
        "admin_notes": { "type": "string" },
        "utm_source": { "type": "string" },
        "created_at": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "full_name", "email", "whatsapp", "ticket_number"]
    },
    "AdminUser": {
      "title": "AdminUser",
      "description": "Administrator login and access log",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "last_login": { "type": "string" },
        "ip": { "type": "string" }
      },
      "required": ["email", "name", "role"]
    },
    "AdminAccount": {
      "title": "AdminAccount",
      "description": "Master administrative authentication and credentials store",
      "type": "object",
      "properties": {
        "email": { "type": "string" },
        "name": { "type": "string" },
        "role": { "type": "string" },
        "password_hash": { "type": "string" },
        "password_salt": { "type": "string" },
        "last_login": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["email", "name", "role"]
    },
    "ClassSettings": {
      "title": "ClassSettings",
      "description": "Configuration for dates, times, live classroom links, and WhatsApp group",
      "type": "object",
      "properties": {
        "class_name": { "type": "string" },
        "class_date": { "type": "string" },
        "class_time": { "type": "string" },
        "class_link": { "type": "string" },
        "whatsapp_group_link": { "type": "string" },
        "registration_status": { "type": "string" },
        "automation_enabled": { "type": "boolean" },
        "founder_image_url": { "type": "string" },
        "countdown_target_date": { "type": "string" },
        "updated_at": { "type": "string" }
      },
      "required": ["class_name", "class_date", "whatsapp_group_link"]
    },
    "EmailTemplate": {
      "title": "EmailTemplate",
      "description": "Email templates for automated notifications and campaigns",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "category": { "type": "string" },
        "subject": { "type": "string" },
        "body": { "type": "string" },
        "is_default": { "type": "boolean" },
        "updated_at": { "type": "string" }
      },
      "required": ["id", "name", "subject", "body"]
    },
    "AnalyticsEvent": {
      "title": "AnalyticsEvent",
      "description": "Tracking event for visitor funnel and interaction analytics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "event": { "type": "string" },
        "url": { "type": "string" },
        "source": { "type": "string" },
        "session_id": { "type": "string" },
        "details": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "event", "timestamp"]
    },
    "AuditLog": {
      "title": "AuditLog",
      "description": "Administrative actions audit log",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "action": { "type": "string" },
        "details": { "type": "string" },
        "admin_email": { "type": "string" },
        "timestamp": { "type": "string" }
      },
      "required": ["id", "action", "timestamp"]
    },
    "VisitorSession": {
      "title": "VisitorSession",
      "description": "Real-time visitor heartbeat and session metrics",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "session_id": { "type": "string" },
        "entered_at": { "type": "string" },
        "last_seen_at": { "type": "string" },
        "active_seconds": { "type": "number" },
        "device": { "type": "string" },
        "browser": { "type": "string" },
        "referrer": { "type": "string" },
        "current_page": { "type": "string" },
        "ip_address": { "type": "string" },
        "user_agent": { "type": "string" },
        "is_active": { "type": "boolean" }
      },
      "required": ["id", "session_id", "entered_at", "last_seen_at"]
    }
  },
  "firestore": {
    "/participants/{participantId}": {
      "schema": "Participant",
      "description": "Student registration entries"
    },
    "/admin_users/{userId}": {
      "schema": "AdminUser",
      "description": "Active admin session and authorized user profiles"
    },
    "/admin_account/{accountId}": {
      "schema": "AdminAccount",
      "description": "Master admin account credentials and profile synchronization"
    },
    "/class_settings/{settingId}": {
      "schema": "ClassSettings",
      "description": "Global workshop and landing page parameters"
    },
    "/email_templates/{templateId}": {
      "schema": "EmailTemplate",
      "description": "Email automation templates"
    },
    "/analytics_events/{eventId}": {
      "schema": "AnalyticsEvent",
      "description": "Visitor interaction telemetry and conversion events"
    },
    "/visitor_sessions/{sessionId}": {
      "schema": "VisitorSession",
      "description": "Active visitor session telemetry and heartbeats"
    },
    "/audit_logs/{logId}": {
      "schema": "AuditLog",
      "description": "Audit trails for administrator actions"
    }
  }
}
