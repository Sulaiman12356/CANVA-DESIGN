rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Admin authentication and accounts
    match /admin_users/{document=**} {
      allow read, write: if true;
    }
    match /admin_account/{document=**} {
      allow read, write: if true;
    }
    // Workshop configuration and settings
    match /class_settings/{document=**} {
      allow read, write: if true;
    }
    // Student registrations
    match /participants/{document=**} {
      allow read, write: if true;
    }
    // Visitor telemetry and live sessions
    match /analytics_events/{document=**} {
      allow read, write: if true;
    }
    match /visitor_sessions/{document=**} {
      allow read, write: if true;
    }
    // Audit logs and email templates
    match /audit_logs/{document=**} {
      allow read, write: if true;
    }
    match /email_templates/{document=**} {
      allow read, write: if true;
    }
    
    // Default fallback
    match /{document=**} {
      allow read, write: if true;
    }
  }
}

