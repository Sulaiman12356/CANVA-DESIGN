# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ==========================================
# META ADS TRACKING & CONVERSIONS API (CAPI)
# ==========================================
# Client-side Meta Pixel ID (loaded by browser)
VITE_META_PIXEL_ID="[INSERT META PIXEL ID]"

# Server-side Meta Conversions API credentials (kept hidden from browser)
# Your Meta Pixel ID or Dataset ID from Meta Events Manager
META_PIXEL_ID="[INSERT META PIXEL ID]"
META_DATASET_ID="[INSERT META DATASET ID]"

# System User Access Token generated in Meta Business Manager (Settings > System Users > Generate New Token)
META_ACCESS_TOKEN=""

# Meta Graph API version (default is v21.0)
META_API_VERSION="v21.0"

# Optional: Meta Test Event Code from Meta Events Manager "Test Events" tab (e.g. TEST12345)
META_TEST_EVENT_CODE=""

# ==========================================
# CLARITY DIGITAL ACADEMY ADMIN AUTHENTICATION
# ==========================================
# Administrator email address for dashboard login
ADMIN_EMAIL="ipesolasulaiman@gmail.com"

# Administrator password for dashboard login (Change in production)
ADMIN_PASSWORD="ClarityAdmin2026!"

# Secret key used for signing JWT admin session tokens
JWT_SECRET="clarity_academy_super_secret_jwt_key_2026"

# ==========================================
# EMAIL DELIVERY INTEGRATION (Transactional & Bulk)
# ==========================================
# Universal / Generic Email API Key (Resend, SendGrid, or Mailgun)
EMAIL_API_KEY=""

# Resend API Key (https://resend.com)
RESEND_API_KEY=""

# SendGrid API Key (https://sendgrid.com)
SENDGRID_API_KEY=""

# Mailgun API Key & Domain (https://mailgun.com)
MAILGUN_API_KEY=""
MAILGUN_DOMAIN=""

# SMTP Direct Configuration (Optional)
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_SECURE="false"

# Sender email and Display Name for automated emails
EMAIL_FROM="claritydigitalacademy@gmail.com"
EMAIL_FROM_NAME="Onifade Sulaiman (Mr. Clarity) - Clarity Digital Academy"

# ==========================================
# SUPABASE DATABASE INTEGRATION (Optional)
# ==========================================
SUPABASE_URL=""
SUPABASE_ANON_KEY=""


